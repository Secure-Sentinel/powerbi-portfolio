              }
            ]
          },
          {
            "name": "OLC_Sekil_Uyari",
            "type": "calculated",
            "expression": "\nVAR SekilPay = CALCULATE( [OLC_CIRO_Genel_Pay], ALLSELECTED( STOK[Kalip_Rapor] ) )\nRETURN IF( SekilPay < 0.01, \"⚠ Şekil toplamı <%1\", BLANK() )",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "61e8f3f9-1e32-4bd9-8f60-b2806141db18",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "TEMSILCI_KEY",
            "type": "calculated",
            "expression": "COALESCE( CIRO[SIPARIS_TEMSILCISI], \"(Temsilcisiz)\" )\n",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "2a376577-5d7e-4a04-9c96-e654674fa712",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "lineageTag": "82b6e37c-d60c-4f19-bc5b-88f48443227c",
        "measures": [
          {
            "name": "OLC_CIRO",
            "expression": "SUM(CIRO[TUTAR_USD])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "31ca27a5-94ca-4cd0-8738-f40006e7bae9",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "OLC_CIRO_Genel_Pay",
            "expression": "\nDIVIDE(\n    [OLC_CIRO],\n    CALCULATE( [OLC_CIRO], ALLSELECTED( STOK ) )\n)",
            "formatString": "%0.0;-%0.0;%0.0",
            "lineageTag": "318830f3-ae2f-41a6-a43f-f010a46231c4"
          },
          {
            "name": "OLC_CIRO_Kumulatif_Pay",
            "expression": "\nVAR MevcutCiro = [OLC_CIRO]\nRETURN\nIF(\n    ISBLANK( MevcutCiro ),\n    BLANK(),\n    SWITCH( TRUE(),\n\n        -- 1) KALIP KIRILIMI: şekil içi kümülatif (en granüler dal EN ÜSTTE)\n        ISINSCOPE( STOK[Kalip_Rapor] ),\n        DIVIDE(\n            SUMX(\n                FILTER( ALLSELECTED( STOK[Kalip_Rapor] ), [OLC_CIRO] >= MevcutCiro ),\n                [OLC_CIRO]\n            ),\n            CALCULATE( [OLC_CIRO], ALLSELECTED( STOK[Kalip_Rapor] ) )\n        ),\n\n        -- 2) ŞEKİL KIRILIMI: genel toplam üzerinden kümülatif\n        ISINSCOPE( STOK[AD1_Rapor] ),\n        DIVIDE(\n            SUMX(\n                FILTER( ALLSELECTED( STOK[AD1_Rapor] ), [OLC_CIRO] >= MevcutCiro ),\n                [OLC_CIRO]\n            ),\n            CALCULATE( [OLC_CIRO], ALLSELECTED( STOK[AD1_Rapor] ) )\n        )\n    )\n)",
            "formatString": "%0.0;-%0.0;%0.0",
            "lineageTag": "6247858c-3a20-4d2d-9b54-fa6d247fa00c"
          },
          {
            "name": "OLC_Kalip_Karar",
            "expression": "\nVAR Pay        = [OLC_CIRO_Kumulatif_Pay]\nVAR PayOncesi  = Pay - [OLC_CIRO_Sekil_Ici_Pay]        -- (1) sınırı aşan kalemi DAHİL et\nVAR Son12      = [OLC_CIRO_Son12Ay]\nVAR IlkSiparis = CALCULATE( MIN( SIPARIS[STHAR_TARIH] ), REMOVEFILTERS( TARIH ) )\nVAR KalipSayisi =                                  -- (2) sadece cirosu olan kalıpları say\n    COUNTROWS( FILTER( ALLSELECTED( STOK[Kalip_Rapor] ), NOT ISBLANK( [OLC_CIRO] ) ) )\nVAR BaskaSekilde =                                 -- (3) kalıp başka şekilde canlı mı\n    CALCULATE( [OLC_CIRO_Son12Ay], ALLSELECTED( STOK[AD1_Rapor] ) ) - Son12\nRETURN\nIF(\n    ISBLANK( [OLC_CIRO] ) || NOT( ISINSCOPE( STOK[Kalip_Rapor] ) ),\n    BLANK(),\n    SWITCH( TRUE(),\n        KalipSayisi = 1,                    \"Tek Kalıp — Ayrı Değerlendir\",\n        NOT( ISBLANK( IlkSiparis ) ) && IlkSiparis >= TODAY() - 365,\n                                            \"Yeni Kalıp — İzle\",\n        PayOncesi < 0.80,                   \"Çekirdek\",\n        ISBLANK( Son12 ) || Son12 = 0,      \"Ölü — Çıkarma Adayı\",\n                                            \"Atıl — MOQ Arttır\"\n    )\n)",
            "lineageTag": "4829c8a1-3303-4881-b54b-ac4246ad83ea"
          },
          {
            "name": "OLC_CIRO_Son12Ay",
            "expression": "\nCALCULATE(\n    [OLC_CIRO],\n    REMOVEFILTERS( TARIH ),\n    DATESINPERIOD( TARIH[Tarih], TODAY(), -12, MONTH )\n)\n\n",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "ed69dab4-f738-481a-9098-5b50fb21bbe7"
          },
          {
            "name": "OLC_Siparis_Sayisi",
            "expression": "DISTINCTCOUNT( SIPARIS[FISNO] )\n\n",
            "formatString": "0",
            "lineageTag": "5cf2ef3f-246c-4dba-9184-e27d6f8ea8cf"
          },
          {
            "name": "OLC_Ort_Siparis_Adedi",
            "expression": "\nDIVIDE( [OLC_SIPARIS_TOPLAMMIKTAR], [OLC_Siparis_Sayisi] )",
            "formatString": "0",
            "lineageTag": "b8d27259-83c3-4e9c-b4c1-7e98788aa6be"
          },
          {
            "name": "OLC_CIRO_Sekil_Ici_Pay",
            "expression": "\nDIVIDE(\n    [OLC_CIRO],\n    CALCULATE( [OLC_CIRO], ALLSELECTED( STOK[Kalip_Rapor] ) )\n)",
            "formatString": "%0.0;-%0.0;%0.0",
            "lineageTag": "6a79e805-32c7-4280-a7f4-94d29ed98ae2"
          }
        ],
        "partitions": [
          {
            "name": "CIRO",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Kaynak = Veri(\"CIRO.csv\"),\n    Tipler = Table.TransformColumnTypes(Kaynak, {{\"STOK_KODU\", type text}, {\"STHAR_CARIKOD\", type text}, {\"FISNO\", type text}, {\"STHAR_TARIH\", type datetime}, {\"STHAR_GCMIK\", type number}, {\"STHAR_GCMIK2\", type number}, {\"STHAR_NF\", type number}, {\"STHAR_GCKOD\", type text}, {\"DOLAR_KURU\", type number}, {\"TUTAR_USD\", type number}, {\"YIL\", Int64.Type}, {\"AY\", Int64.Type}, {\"STHAR_SIPNUM\", type text}, {\"STRA_SIPKONT\", Int64.Type}, {\"SIP_INC\", Int64.Type}, {\"AY_BASLANGICI\", type datetime}, {\"SIPARIS_TEMSILCISI\", type text}, {\"TEMSILCI_GRUP\", type text}}, \"en-US\")\nin\n    Tipler"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Gezinme"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
