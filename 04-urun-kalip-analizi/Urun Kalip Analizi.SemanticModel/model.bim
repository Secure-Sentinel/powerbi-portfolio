              }
            ]
          },
          {
            "name": "Satis Tipi",
            "type": "calculated",
            "expression": "\nSWITCH (\n    TRUE (),\n    CONTAINSSTRING ( 'SIPARIS'[FISNO], \"STKB\" ), \"Baskılı Satış\",\n    CONTAINSSTRING ( 'SIPARIS'[FISNO], \"STK\" ), \"Stok Satışı\",\n    \"Üretim\"\n)",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "689a73f8-2383-4105-8244-ef112f073b2b",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "TEMSILCI_KEY",
            "type": "calculated",
            "expression": "COALESCE( SIPARIS[SIPARIS_TEMSILCI], \"(Temsilcisiz)\" )",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "0a008e82-b7c6-4683-8031-7e95af99ee6f",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "lineageTag": "40d5f461-6efc-4b2e-84d8-646086c4a717",
        "measures": [
          {
            "name": "OLC_SIPARIS_TOPLAMMIKTAR",
            "expression": "SUM(SIPARIS[STHAR_GCMIK])",
            "formatString": "#,0",
            "lineageTag": "f4cb0e68-2b54-40ef-8cd7-c0a485142cf0"
          },
          {
            "name": "OLC_SIPARIS_TOPLAMTUTAR",
            "expression": "SUM(SIPARIS[TUTAR_USD])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "1acabac7-24fa-4e43-b357-00c338e0e60f"
          },
          {
            "name": "OLC_Satis_Payi_%",
            "expression": "\nDIVIDE(\n    [OLC_SIPARIS_TOPLAMMIKTAR], \n    CALCULATE([OLC_SIPARIS_TOPLAMMIKTAR], ALLSELECTED(STOK[KOD_3]))\n)",
            "formatString": "%0.00;-%0.00;%0.00",
            "lineageTag": "5d1a8551-fb69-479e-96ac-4bca2a09736f"
          },
          {
            "name": "OLC_Hiyerarsik_Kumulatif_Pay",
            "expression": "\nVAR MevcutMiktar = [OLC_SIPARIS_TOPLAMMIKTAR]\n\nRETURN\nIF(\n    ISBLANK(MevcutMiktar) || MevcutMiktar <= 0, \n    BLANK(),\n    VAR KumulatifToplam = \n        SWITCH( TRUE(),\n            -- 1. En Alt Seviye: Stok Adı\n            ISINSCOPE(STOK[STOK_ADI]), \n            SUMX(\n                FILTER(\n                    ALLSELECTED(STOK[STOK_ADI], STOK[KT_YUKSEKLIK], STOK[KOD_3]),\n                    [OLC_SIPARIS_TOPLAMMIKTAR] >= MevcutMiktar\n                ),\n                [OLC_SIPARIS_TOPLAMMIKTAR]\n            ),\n\n            -- 2. Orta Seviye: Yükseklik\n            ISINSCOPE(STOK[KT_YUKSEKLIK]), \n            SUMX(\n                FILTER(\n                    ALLSELECTED(STOK[KT_YUKSEKLIK], STOK[KOD_3]),\n                    [OLC_SIPARIS_TOPLAMMIKTAR] >= MevcutMiktar\n                ),\n                [OLC_SIPARIS_TOPLAMMIKTAR]\n            ),\n\n            -- 3. Üst Seviye: Kalıp (KOD_3)\n            ISINSCOPE(STOK[KOD_3]), \n            SUMX(\n                FILTER(\n                    ALLSELECTED(STOK[KOD_3]),\n                    [OLC_SIPARIS_TOPLAMMIKTAR] >= MevcutMiktar\n                ),\n                [OLC_SIPARIS_TOPLAMMIKTAR]\n            )\n        )\n\n    -- Toplam miktar hesabı (Payda)\n    VAR ToplamMiktar = \n        SWITCH( TRUE(),\n            ISINSCOPE(STOK[STOK_ADI]), CALCULATE([OLC_SIPARIS_TOPLAMMIKTAR], ALLSELECTED(STOK[STOK_ADI], STOK[KT_YUKSEKLIK], STOK[KOD_3])),\n            ISINSCOPE(STOK[KT_YUKSEKLIK]), CALCULATE([OLC_SIPARIS_TOPLAMMIKTAR], ALLSELECTED(STOK[KT_YUKSEKLIK], STOK[KOD_3])),\n            ISINSCOPE(STOK[KOD_3]), CALCULATE([OLC_SIPARIS_TOPLAMMIKTAR], ALLSELECTED(STOK[KOD_3]))\n        )\n\n    RETURN DIVIDE(KumulatifToplam, ToplamMiktar)\n)",
            "formatString": "%0.00;-%0.00;%0.00",
            "lineageTag": "61edacd2-e4c0-41bd-9ecf-65cad6225664"
          },
          {
            "name": "OLC_KOD3_Siniflandirma",
            "expression": "\nVAR Pay = [OLC_Hiyerarsik_Kumulatif_Pay]\nRETURN\nIF(\n    ISBLANK(Pay),\n    BLANK(),\n    SWITCH( TRUE(),\n        Pay <= 0.70, \"Çekirdek Ürünler\",\n        Pay <= 0.85, \"İzleme Grubu\",\n        \"Temizlik Listesi\"\n    )\n)",
            "lineageTag": "d22837b8-da92-4ed4-b6e4-f31e6a58e469"
          },
          {
            "name": "OLC_Hiyerarsik_Pay_%",
            "expression": "\nVAR MevcutMiktar = [OLC_SIPARIS_TOPLAMMIKTAR]\n\n-- Üst kırılımların toplamlarını hesaplayalım\nVAR KalipToplami = CALCULATE([OLC_SIPARIS_TOPLAMMIKTAR], ALLSELECTED(STOK[KOD_3], STOK[KT_YUKSEKLIK], STOK[STOK_ADI]))\nVAR YukseklikToplami = CALCULATE([OLC_SIPARIS_TOPLAMMIKTAR], ALLSELECTED(STOK[KT_YUKSEKLIK], STOK[STOK_ADI]))\nVAR StokToplami = CALCULATE([OLC_SIPARIS_TOPLAMMIKTAR], ALLSELECTED(STOK[STOK_ADI]))\n\nRETURN\nSWITCH( TRUE(),\n    -- 1. En alt seviye: Stok Adı'nın Yükseklik içindeki payı\n    ISINSCOPE(STOK[STOK_ADI]), DIVIDE(MevcutMiktar, StokToplami),\n    \n    -- 2. Orta seviye: Yükseklik'in Kalıp içindeki payı\n    ISINSCOPE(STOK[KT_YUKSEKLIK]), DIVIDE(MevcutMiktar, YukseklikToplami),\n    \n    -- 3. Üst seviye: Kalıp'ın Genel Toplam içindeki payı\n    ISINSCOPE(STOK[KOD_3]), DIVIDE(MevcutMiktar, KalipToplami),\n    \n    1 -- Genel Toplam satırı için %100 döner\n)",
            "formatString": "%0.00;-%0.00;%0.00",
            "lineageTag": "0cae5c74-9085-48ab-ac4c-d77fc135e8e1"
          }
        ],
        "partitions": [
          {
            "name": "SIPARIS",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Kaynak = Veri(\"SIPARIS.csv\"),\n    Tipler = Table.TransformColumnTypes(Kaynak, {{\"INCKEYNO\", Int64.Type}, {\"STHAR_TARIH\", type datetime}, {\"FISNO\", type text}, {\"SIRA\", Int64.Type}, {\"STOK_KODU\", type text}, {\"STHAR_CARIKOD\", type text}, {\"STHAR_GCMIK\", type number}, {\"STHAR_NF\", type number}, {\"GONDERILEN\", type number}, {\"KALAN\", type number}, {\"SIPARIS_TEMSILCI\", type text}, {\"DEPARTMAN\", type text}, {\"STHAR_GCKOD\", type text}, {\"DOLAR_KURU\", type number}, {\"STHAR_KOD1\", type text}, {\"STHAR_KOD2\", type text}, {\"TUTAR_USD\", type number}, {\"DURUM\", type text}, {\"YIL\", Int64.Type}, {\"AY\", Int64.Type}, {\"HAFTA\", Int64.Type}, {\"ODEKOD\", type text}, {\"ODEME_ACIKLAMA\", type text}, {\"PESINAT_ORANI\", type number}, {\"VADE_GUNU\", Int64.Type}, {\"PESIN_TUTAR\", type number}, {\"VADELI_TUTAR\", type number}, {\"RPT\", Int64.Type}, {\"KACINCI_SIPARIS\", Int64.Type}}, \"en-US\")\nin\n    Tipler"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Gezinme"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
