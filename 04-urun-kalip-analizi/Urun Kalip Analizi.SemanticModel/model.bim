          {
            "name": "KUTU_GRUBU",
            "type": "calculated",
            "expression": "\nSWITCH( TRUE(),\n    -- YUVARLAK GRUBU\n    STOK[AD1] IN {\"Yuvarlak Kutu\", \"Yuvarlak-Sivama Kutu\"}, \"YUVARLAK\",\n\n    -- KARE GRUBU\n    STOK[AD1] = \"Kare Kutu\", \"KARE\",\n\n    -- ŞEKİLLİ GRUBU\n    STOK[AD1] IN {\"Altıgen Kutu\", \"Dikdortgen Kutu\", \"Sekilli Kutu\", \"Sekizgen Kutu\"}, \"ŞEKİLLİ\",\n\n    -- OVAL GRUBU\n    STOK[AD1] = \"Oval Kutu\", \"OVAL\",\n\n    -- KALP GRUBU\n    STOK[AD1] = \"Kalp Kutu\", \"KALP\",\n\n    -- DİĞER GRUBU\n    STOK[AD1] IN {\n        \"Kapak\", \"Koseli Sivama Kutu\", \"Plaka-Bardak Alti\", \n        \"Sadece Dip\", \"Sadece Kapak\", \"Tel Mekanizmali Kutu\", \"Tepsi\"\n    }, \"DİĞER\",\n\n    -- EĞER LİSTEDE OLMAYAN BİR DEĞER GELİRSE\n    \"DİĞER\"\n)",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "ef7ffd8d-6a7f-4705-b3f3-8009c7078d2a",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "AD1_Rapor",
            "type": "calculated",
            "expression": "\n-- Kalıp ile şekil kaynakta birebir eşleşiyor; düzeltmeye gerek yok.\n-- Şekil çeşitleri de gruplanmaz: katalogdaki 16 şeklin tamamı ayrı görünür.\nSTOK[AD1]",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "013a5781-985a-4732-b648-47073c5a3533",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "AD1_New",
            "type": "calculated",
            "expression": "\nSWITCH(\n    TRUE(),\n    STOK[AD1] IN { \"Altıgen Kutu\", \"Sekizgen Kutu\" }, \"Sekilli Kutu\",\n    STOK[AD1]\n)",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "faaf2d65-21db-494f-8cd4-83b64762dfb1",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "KOD3_New",
            "type": "calculated",
            "expression": "\n-- Kalıp ile şekil kaynakta birebir eşleşiyor; düzeltmeye gerek yok.\nSTOK[AD1]",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "c323bc41-9be5-46f4-82ac-01c420e55ca3",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Kalip_Rapor",
            "type": "calculated",
            "expression": "\n-- Kalıp kodları kaynakta tekil; birleştirmeye gerek yok.\nSTOK[KOD_3]",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "6229eb96-6a8b-492f-af46-bf4257c24d21",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "lineageTag": "8a2fa17e-e0e9-467c-a3aa-211568e8f285",
        "partitions": [
          {
            "name": "STOK",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Kaynak = Veri(\"STOK.csv\"),\n    Tipler = Table.TransformColumnTypes(Kaynak, {{\"STOK_KODU\", type text}, {\"STOK_ADI\", type text}, {\"GRUP_KODU\", type text}, {\"GRUP_ADI\", type text}, {\"KOD_1\", type text}, {\"AD1\", type text}, {\"KOD_2\", type text}, {\"AD2\", type text}, {\"KOD_3\", type text}, {\"AD3\", type text}, {\"KOD_4\", type text}, {\"AD4\", type text}, {\"KOD_5\", type text}, {\"AD5\", type text}, {\"INGISIM\", type text}, {\"KT_YUKSEKLIK\", type number}, {\"OLCU_BR1\", type text}, {\"OLCU_BR2\", type text}, {\"OLCU_BR3\", type text}, {\"BIRIM2_CARPAN\", type number}, {\"BIRIM3_CARPAN\", type number}, {\"BIRIM_MALIYET\", type number}}, \"en-US\")\nin\n    Tipler"
            }
          }
        ],
        "annotations": [
