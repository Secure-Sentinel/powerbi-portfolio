            "expression": "\nIF (\n    ISBLANK ( SATINALMA_SIPARIS[TERMINE_KALAN_GUN] ),\n    BLANK (),\n    - SATINALMA_SIPARIS[TERMINE_KALAN_GUN]\n)",
