              "expression": "let\n    Kaynak = Veri(\"SATINALMA_SIPARIS.csv\"),\n    Tipler = Table.TransformColumnTypes(Kaynak, {{\"INCKEYNO\", Int64.Type}, {\"STHAR_TARIH\", type date}, {\"FISNO\", type text}, {\"SIRA\", Int64.Type}, {\"STOK_KODU\", type text}, {\"STHAR_CARIKOD\", type text}, {\"STHAR_GCMIK\", type number}, {\"STHAR_NF\", type number}, {\"ALINAN\", type number}, {\"STHAR_HTUR\", type text}, {\"TERMIN\", type date}, {\"SIPARIS_TARIHINDEN_GECEN_GUN\", Int64.Type}, {\"TERMINE_KALAN_GUN\", Int64.Type}, {\"KALAN\", type number}, {\"STHAR_GCKOD\", type text}, {\"DOLAR_KURU\", type number}, {\"STHAR_KOD1\", type text}, {\"STHAR_KOD2\", type text}, {\"TUTAR_USD\", type number}, {\"DURUM\", type text}, {\"YIL\", Int64.Type}, {\"AY\", Int64.Type}, {\"HAFTA\", Int64.Type}}, \"en-US\")\nin\n    Tipler"
            }
          }
        ],
