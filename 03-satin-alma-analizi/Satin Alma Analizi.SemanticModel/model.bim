          },
          {
            "name": "OLC_ALACAKBORC_TOPLAMBAKIYE_TL",
            "expression": "\nSUMX(\n    CARI_ALACAKBORC,\n    ABS(CARI_ALACAKBORC[BAKIYE_TL])\n)",
            "lineageTag": "0eddacbc-ef7b-48f6-913e-b8c1dc50f2a4",
            "annotations": [
