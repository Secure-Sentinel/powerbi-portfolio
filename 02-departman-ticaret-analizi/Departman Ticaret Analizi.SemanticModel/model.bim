              }
            ]
          }
        ],
        "lineageTag": "961dbedb-c459-488d-9780-3f24b564136d",
        "measures": [
          {
            "name": "Matrix Satis Degeri",
            "expression": "\nVAR SeciliGrup = SELECTEDVALUE ( 'MatrixSatisGruplari'[Grup] )\nRETURN\n    SWITCH (\n        TRUE (),\n        SeciliGrup = \"Toplam\", [OLC_SIPARIS_TOPLAMTUTAR],\n\n        SeciliGrup = \"Aylık Ortalama\", AVERAGEX (\n            VALUES ( 'SATINALMA_TARIHLER'[AyNo] ),\n            [OLC_SIPARIS_TOPLAMTUTAR]\n        ),\n        SeciliGrup = \"Sipariş Sayısı\", [OLC_SIPARIS_SIPARISSAYISI],\n        SeciliGrup = \"Çeyrek 1\", CALCULATE ( [OLC_SIPARIS_TOPLAMTUTAR], 'SATINALMA_TARIHLER'[CeyrekNo] = 1 ),\n        SeciliGrup = \"Çeyrek 2\", CALCULATE ( [OLC_SIPARIS_TOPLAMTUTAR], 'SATINALMA_TARIHLER'[CeyrekNo] = 2 ),\n        SeciliGrup = \"Çeyrek 3\", CALCULATE ( [OLC_SIPARIS_TOPLAMTUTAR], 'SATINALMA_TARIHLER'[CeyrekNo] = 3 ),\n        SeciliGrup = \"Çeyrek 4\", CALCULATE ( [OLC_SIPARIS_TOPLAMTUTAR], 'SATINALMA_TARIHLER'[CeyrekNo] = 4 ),\n        SeciliGrup = \"1. Yarıyıl\", CALCULATE ( [OLC_SIPARIS_TOPLAMTUTAR], 'SATINALMA_TARIHLER'[YariYilNo] = 1 ),\n        SeciliGrup = \"2. Yarıyıl\", CALCULATE ( [OLC_SIPARIS_TOPLAMTUTAR], 'SATINALMA_TARIHLER'[YariYilNo] = 2 ),\n        BLANK ()\n    )",
            "lineageTag": "e744c69c-a68c-420a-810f-82d8ac35851a"
          },
          {
            "name": "Kalıp Sıralaması (Tutar)",
            "expression": "\nRANKX (\n    ALLSELECTED ( STOK[KOD_3] ),\n    [OLC_SIPARIS_TOPLAMTUTAR],\n    , \n    DESC, // \n    Dense\n)",
            "formatString": "0",
            "lineageTag": "fca218ac-702c-4ae1-a3f0-1aeb96fdbbcb"
          },
          {
            "name": "Peşinat Sıralaması (Tutar)",
            "expression": "\nRANKX (\n    ALLSELECTED ( SIPARIS[ODEME_ACIKLAMA] ),\n    [OLC_SIPARIS_TOPLAMTUTAR],\n    , \n    DESC,\n    Dense\n)",
            "formatString": "0",
            "lineageTag": "ef7c9d1e-6790-4b1b-a27d-7a900d19767d"
          }
        ],
        "partitions": [
          {
            "name": "MatrixSatisGruplari",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Kaynak = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlTSUQrJL8hJzFWK1YlWMgJyHStzjmzMVvAvKkkECieCxY2B4sGZBYlFmUfnKwQnVh7ZWHxkI1jGBChzuD21sig1W8EQLGKKJGIEFjFDEjEGi5gjiZiARSyAIoZ6CpGJRUc2Ao3PAQtaAgWNUARjAQ==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Sıra = _t, Grup = _t]),\n    #\"Değiştirilen Tür\" = Table.TransformColumnTypes(Kaynak,{{\"Sıra\", Int64.Type}, {\"Grup\", type text}})\nin\n    #\"Değiştirilen Tür\""
            }
          }
        ],
        "annotations": [
