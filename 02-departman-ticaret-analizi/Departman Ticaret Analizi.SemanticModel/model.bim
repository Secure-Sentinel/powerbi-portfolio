          },
          {
            "name": "SeciliTarihAraligi",
            "expression": "\nVAR MinTarih = MIN ( 'SATINALMA_TARIHLER'[Tarih] )\nVAR MaxTarih = MAX ( 'SATINALMA_TARIHLER'[Tarih] )\nRETURN\n    FORMAT ( MinTarih, \"d MMMM yyyy\", \"tr-TR\" )\n        & \" - \"\n        & FORMAT ( MaxTarih, \"d MMMM yyyy\", \"tr-TR\" )",
            "lineageTag": "2c65b1f8-9654-4849-ad0f-65ceb3493002"
          }
        ],
        "partitions": [
          {
            "name": "SATINALMA_TARIHLER",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Baslangic = #date(2012, 1, 1),\n    Bitis = #date(2030, 1, 1),\n    GunSayisi = Duration.Days(Bitis - Baslangic) + 1,\n    Liste = List.Dates(Baslangic, GunSayisi, #duration(1, 0, 0, 0)),\n    Tablo = Table.FromList(Liste, Splitter.SplitByNothing(), {\"Tarih\"}),\n    Tipler = Table.TransformColumnTypes(Tablo, {{\"Tarih\", type date}})\nin\n    Tipler"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Gezinme"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
