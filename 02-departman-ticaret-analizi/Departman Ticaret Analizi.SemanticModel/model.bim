        ],
        "lineageTag": "59a8ca44-4edf-4eb4-bbd0-25023c5527f8",
        "measures": [
          {
            "name": "OLC_CIRO_GECENSENEBUGUNEKADAR",
            "expression": "\n// 1. Filtrede kaç farklı yıl seçildiğini say (N)\nVAR _SelectedYearCount =\n    DISTINCTCOUNT ( 'SATINALMA_TARIHLER'[Yil] )\n\n// 2. Eğer hiç yıl seçili değilse, BLANK döndür\nRETURN\nIF (\n    NOT ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    BLANK (),\n\n    // 3. 1. Adım'daki motoru çağır ve N yıl geriye kaydır\n    CALCULATE (\n        [OLC_CIRO_YTD_Core],\n        DATEADD ( 'SATINALMA_TARIHLER'[Tarih], -_SelectedYearCount, YEAR )\n    )\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "95d479fb-a5eb-4bde-a661-d059d293cf1e"
          },
          {
            "name": "OLC_CIRO_MUSTERISAYISI",
            "expression": "DISTINCTCOUNT(CIRO[STHAR_CARIKOD])",
            "formatString": "0",
            "lineageTag": "813f064a-8f2d-4321-9815-0f8555f0235b"
          },
          {
            "name": "OLC_CIRO_MUSTERI_ORTALAMA",
            "expression": "\nVAR T = SUMMARIZE (\n    CIRO,\n    CIRO[STHAR_CARIKOD],\n    \"TOPLAM\", [OLC_CIRO]\n)\nVAR ORT = AVERAGEX ( T, [TOPLAM] )\nRETURN\n    ORT",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "718d835c-5566-4b5e-9333-f4a991a1782b"
          },
          {
            "name": "OLC_CIRO_KALIPSAYISI",
            "expression": "\nCALCULATE (\n    DISTINCTCOUNT ( STOK[KOD_3] ),\n    CIRO \n)",
            "formatString": "0",
            "lineageTag": "09e9838f-65f3-4e8b-ab37-c310476a0f2f"
          },
          {
            "name": "OLC_CIRO_TOPLAM_MIKTAR",
            "expression": "SUM(CIRO[STHAR_GCMIK])",
            "formatString": "0",
            "lineageTag": "38b09dac-23da-465c-817f-44ed890e19e6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "OLC_CIRO",
            "expression": "SUM(CIRO[TUTAR_USD])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "91e799e6-cec0-4da2-9e94-4bd0864ee13f"
          },
          {
            "name": "OLC_CIRO_YTD",
            "expression": "\n// Yıl filtresinde en az 1 seçim varsa (boş değilse) hesapla\nIF (\n    ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    [OLC_CIRO_YTD_Core], // 1. Adım'daki motoru çağır\n    BLANK () // Yıl filtresi boşsa (0 seçim) BLANK döndür\n)",
            "lineageTag": "4143812c-d515-4a6c-9bd4-938eb57d2e63",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_CIRO_TOP5",
            "expression": "\nSUMX (\n    TOPN (\n        5,\n        SUMMARIZE ( CIRO, CIRO[STHAR_CARIKOD], \"TOPLAM\", [OLC_CIRO] ),\n        [TOPLAM]\n    ),\n    [TOPLAM]\n)",
            "lineageTag": "8bed9085-d911-47bd-8af8-e4c151a505da",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_CIRO_TOP5_ORAN",
            "expression": "\nDIVIDE(\n    [OLC_CIRO_TOP5], // Az önce oluşturduğumuz İlk 5 ölçüsü\n    [OLC_CIRO],             // Temel ciro ölçümüz\n    0                       // Hata durumunda (ciro 0 ise) 0 döndür\n)",
            "formatString": "%0.0;-%0.0;%0.0",
            "lineageTag": "bb91f079-9e7b-450d-bc4e-39178c85b7b5"
          },
          {
            "name": "OLC_CIRO_KUTUBASI",
            "expression": "\nDIVIDE (\n    [OLC_CIRO],        // Pay (Numerator)\n    [OLC_CIRO_TOPLAM_MIKTAR], // Payda (Denominator)\n    0                         // Eğer Miktar 0 ise hata verme, \"0\" sonucunu döndür\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "08051d26-a2d1-4b8d-996e-5db597ec1f2d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "TUTAR_USD_2Hane",
            "expression": "\nSUM(CIRO[TUTAR_USD])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "ddfab57f-b1c8-475e-b366-6d9cabc5e0ef"
          },
          {
            "name": "Ciro Büyüme Yüzdesi (YTD)",
            "expression": "\nVAR _YTD  = [OLC_CIRO_YTD]\nVAR _LYTD = [OLC_CIRO_GECENSENEBUGUNEKADAR]\nRETURN\nIF(\n    ISBLANK(_YTD) || ISBLANK(_LYTD) || _LYTD = 0,\n    BLANK(),\n    DIVIDE(_YTD - _LYTD, _LYTD)\n)\n",
            "formatString": "%0.00;-%0.00;%0.00",
            "lineageTag": "4f37fa82-9afa-4bfd-bf15-1209deaa8444"
          },
          {
            "name": "Ciro Büyüme KPI Metni (YTD)",
            "expression": "\nVAR _YuzdeFark = [Ciro Büyüme Yüzdesi (YTD)]\n\nRETURN\nIF (\n    ISBLANK ( _YuzdeFark ),\n    BLANK (),\n    \n    // Değerlere göre okları (Unicode) seç\n    VAR _Ok = SWITCH (\n        TRUE (),\n        _YuzdeFark > 0, \"▲\", // Yükseliş oku\n        _YuzdeFark < 0, \"▼\", // Düşüş oku\n        \"–\" // Değişim yoksa\n    )\n    \n    // Yüzdeyi metne çevir ve ok ile birleştir\n    VAR _YuzdeMetni = FORMAT ( _YuzdeFark, \"0.0%\" )\n    \n    RETURN\n        _Ok & \" \" & _YuzdeMetni\n)",
            "lineageTag": "647a8bb8-767d-4a62-afa5-c305a3581961"
          },
          {
            "name": "OLC_TOPLAM_MIKTAR_YTD",
            "expression": "\nIF (\n    ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    [OLC_TOPLAM_MIKTAR_YTD_Core], // 4a'yı çağır\n    BLANK ()\n)",
            "lineageTag": "a9dd44bf-781b-489d-bc73-75ded0aca256",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_TOPLAM_MIKTAR_LYTD",
            "expression": "\nVAR _SelectedYearCount =\n    DISTINCTCOUNT ( 'SATINALMA_TARIHLER'[Yil] )\n    RETURN\nIF (\n    NOT ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    BLANK (),\n    CALCULATE (\n        [OLC_TOPLAM_MIKTAR_YTD_Core], // 4a'yı çağır\n        DATEADD ( 'SATINALMA_TARIHLER'[Tarih], -_SelectedYearCount, YEAR )\n    )\n)",
            "lineageTag": "97ff9373-5ac1-4902-9296-2797ae6fa5f9",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Toplam Miktar Büyüme Yüzdesi (YTD)",
            "expression": "\nDIVIDE(\n    [OLC_TOPLAM_MIKTAR_YTD] - [OLC_TOPLAM_MIKTAR_LYTD],\n    [OLC_TOPLAM_MIKTAR_LYTD]\n)",
            "formatString": "%0.00;-%0.00;%0.00",
            "lineageTag": "05335331-b40e-423f-9b9d-34fb90e20915"
          },
          {
            "name": "Toplam Miktar Büyüme KPI Metni (YTD)",
            "expression": "\nVAR _YuzdeFark = [Toplam Miktar Büyüme Yüzdesi (YTD)]\nRETURN\nIF(ISBLANK(_YuzdeFark), BLANK(),\n    VAR _Ok = SWITCH(TRUE(), _YuzdeFark > 0, \"▲\", _YuzdeFark < 0, \"▼\", \"–\")\n    VAR _YuzdeMetni = FORMAT(_YuzdeFark, \"0.0%\")\n    RETURN _Ok & \" \" & _YuzdeMetni\n)",
            "lineageTag": "c4246ef7-e95b-49e1-9f88-00cabc20b883"
          },
          {
            "name": "OLC_MUSTERI_SAYISI_YTD",
            "expression": "\nIF (\n    ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    [OLC_MUSTERI_SAYISI_YTD_Core], // 1a'yı çağır\n    BLANK ()\n)",
            "formatString": "0",
            "lineageTag": "89947e9d-5dd1-4e49-9935-eb1a6b1eed40"
          },
          {
            "name": "OLC_MUSTERI_SAYISI_LYTD",
            "expression": "\nVAR _SelectedYearCount =\n    DISTINCTCOUNT ( 'SATINALMA_TARIHLER'[Yil] )\n    RETURN\nIF (\n    NOT ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    BLANK (),\n    CALCULATE (\n        [OLC_MUSTERI_SAYISI_YTD_Core], // 1a'yı çağır\n        DATEADD ( 'SATINALMA_TARIHLER'[Tarih], -_SelectedYearCount, YEAR )\n    )\n)",
            "formatString": "0",
            "lineageTag": "403053e4-893c-4281-a86c-3352ec9f7e3b"
          },
          {
            "name": "Musteri Sayisi Büyüme Yüzdesi (YTD)",
            "expression": "\nDIVIDE(\n    [OLC_MUSTERI_SAYISI_YTD] - [OLC_MUSTERI_SAYISI_LYTD],\n    [OLC_MUSTERI_SAYISI_LYTD]\n)",
            "lineageTag": "11c196fd-e05d-4978-a268-b388d5fd754d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Musteri Sayisi Büyüme KPI Metni (YTD)",
            "expression": "\nVAR _YuzdeFark = [Musteri Sayisi Büyüme Yüzdesi (YTD)]\nRETURN\nIF(ISBLANK(_YuzdeFark), BLANK(),\n    VAR _Ok = SWITCH(TRUE(), _YuzdeFark > 0, \"▲\", _YuzdeFark < 0, \"▼\", \"–\")\n    VAR _YuzdeMetni = FORMAT(_YuzdeFark, \"0.0%\")\n    RETURN _Ok & \" \" & _YuzdeMetni\n)",
            "lineageTag": "65825287-e1d9-4644-bc7c-991a84c76931"
          },
          {
            "name": "OLC_KALIP_SAYISI_YTD",
            "expression": "\nIF (\n    ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    [OLC_KALIP_SAYISI_YTD_Core], // 2a'yı çağır\n    BLANK ()\n)",
            "formatString": "0",
            "lineageTag": "f51e8dd0-8720-4729-a0d4-77dff19c39e4"
          },
          {
            "name": "OLC_KALIP_SAYISI_LYTD",
            "expression": "\nVAR _SelectedYearCount =\n    DISTINCTCOUNT ( 'SATINALMA_TARIHLER'[Yil] )\n    RETURN\nIF (\n    NOT ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    BLANK (),\n    CALCULATE (\n        [OLC_KALIP_SAYISI_YTD_Core], // 2a'yı çağır\n        DATEADD ( 'SATINALMA_TARIHLER'[Tarih], -_SelectedYearCount, YEAR )\n    )\n)",
            "formatString": "0",
            "lineageTag": "066a33b9-475b-4fcd-b6b9-4ce05eccbd44"
          },
          {
            "name": "Kalıp Sayısı Büyüme Yüzdesi (YTD)",
            "expression": "\nDIVIDE(\n    [OLC_KALIP_SAYISI_YTD] - [OLC_KALIP_SAYISI_LYTD],\n    [OLC_KALIP_SAYISI_LYTD]\n)",
            "lineageTag": "5a2fc435-3eeb-4a30-8bb4-677d4ea4a89c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Kalıp Sayısı Büyüme KPI Metni (YTD)",
            "expression": "\nVAR _YuzdeFark = [Kalıp Sayısı Büyüme Yüzdesi (YTD)]\nRETURN\nIF(ISBLANK(_YuzdeFark), BLANK(),\n    VAR _Ok = SWITCH(TRUE(), _YuzdeFark > 0, \"▲\", _YuzdeFark < 0, \"▼\", \"–\")\n    VAR _YuzdeMetni = FORMAT(_YuzdeFark, \"0.0%\")\n    RETURN _Ok & \" \" & _YuzdeMetni\n)",
            "lineageTag": "305b6e88-40f3-47ee-9e82-3ba8faec40aa"
          },
          {
            "name": "OLC_MUSTERI_ORT_YTD",
            "expression": "\nIF (\n    ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    [OLC_MUSTERI_ORT_YTD_Core], // 3a'yı çağır\n    BLANK ()\n)",
            "lineageTag": "03661f9d-6ce4-4737-b0ae-15d8e794b17a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_MUSTERI_ORT_LYTD",
            "expression": "\nVAR _SelectedYearCount =\n    DISTINCTCOUNT ( 'SATINALMA_TARIHLER'[Yil] )\n    RETURN\nIF (\n    NOT ISFILTERED ( 'SATINALMA_TARIHLER'[Yil] ),\n    BLANK (),\n    CALCULATE (\n        [OLC_MUSTERI_ORT_YTD_Core], // 3a'yı çağır\n        DATEADD ( 'SATINALMA_TARIHLER'[Tarih], -_SelectedYearCount, YEAR )\n    )\n)",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "28f0a2b2-0f74-4927-a75c-77b58ae253c9"
          },
          {
            "name": "Musteri Ort. Büyüme Yüzdesi (YTD)",
            "expression": "\nDIVIDE(\n    [OLC_MUSTERI_ORT_YTD] - [OLC_MUSTERI_ORT_LYTD],\n    [OLC_MUSTERI_ORT_LYTD]\n)",
            "lineageTag": "fc013383-edd0-4280-9f5d-11e7985968c7",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Musteri Ort. Büyüme KPI Metni (YTD)",
            "expression": "\nVAR _YuzdeFark = [Musteri Ort. Büyüme Yüzdesi (YTD)]\nRETURN\nIF(ISBLANK(_YuzdeFark), BLANK(),\n    VAR _Ok = SWITCH(TRUE(), _YuzdeFark > 0, \"▲\", _YuzdeFark < 0, \"▼\", \"–\")\n    VAR _YuzdeMetni = FORMAT(_YuzdeFark, \"0.0%\")\n    RETURN _Ok & \" \" & _YuzdeMetni\n)",
            "lineageTag": "e77791a4-e9e4-4958-ab70-8795dcb56d80"
          },
          {
            "name": "OLC_CIRO_YTD_Core",
            "expression": "\n// Bu ölçü YIL'a dokunmaz, sadece AY ve GÜN'e göre filtreler\nVAR _TodayMonth = MONTH ( TODAY () )\nVAR _TodayDay = DAY ( TODAY () )\nRETURN\n    CALCULATE (\n        [OLC_CIRO], // Temel ciro ölçün\n        FILTER (\n            'SATINALMA_TARIHLER',\n            'SATINALMA_TARIHLER'[AyNo] < _TodayMonth\n            || (\n                'SATINALMA_TARIHLER'[AyNo] = _TodayMonth\n                && 'SATINALMA_TARIHLER'[GunNo] <= _TodayDay\n            )\n        )\n    )",
            "lineageTag": "ee6f1029-01db-48b6-8bd9-bd5fb1f2bf33",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_MUSTERI_SAYISI_YTD_Core",
            "expression": "\nVAR _TodayMonth = MONTH ( TODAY () )\nVAR _TodayDay = DAY ( TODAY () )\nRETURN\n    CALCULATE (\n        [OLC_CIRO_MUSTERISAYISI], // <-- Sadece burası değişti\n        FILTER (\n            'SATINALMA_TARIHLER',\n            'SATINALMA_TARIHLER'[AyNo] < _TodayMonth\n            || (\n                'SATINALMA_TARIHLER'[AyNo] = _TodayMonth\n                && 'SATINALMA_TARIHLER'[GunNo] <= _TodayDay\n            )\n        )\n    )",
            "formatString": "0",
            "lineageTag": "c12c8660-c5d6-4de7-8e90-6d3bfe910708"
          },
          {
            "name": "OLC_KALIP_SAYISI_YTD_Core",
            "expression": "\nVAR _TodayMonth = MONTH ( TODAY () )\nVAR _TodayDay = DAY ( TODAY () )\nRETURN\n    CALCULATE (\n        [OLC_CIRO_KALIPSAYISI], // <-- Sadece burası değişti\n        FILTER (\n            'SATINALMA_TARIHLER',\n            'SATINALMA_TARIHLER'[AyNo] < _TodayMonth\n            || (\n                'SATINALMA_TARIHLER'[AyNo] = _TodayMonth\n                && 'SATINALMA_TARIHLER'[GunNo] <= _TodayDay\n            )\n        )\n    )",
            "formatString": "0",
            "lineageTag": "ddc6cd93-f0c5-44c5-b556-6c48dbadb886"
          },
          {
            "name": "OLC_MUSTERI_ORT_YTD_Core",
            "expression": "\nVAR _TodayMonth = MONTH ( TODAY () )\nVAR _TodayDay = DAY ( TODAY () )\nRETURN\n    CALCULATE (\n        [OLC_CIRO_MUSTERI_ORTALAMA], // <-- Sadece burası değişti\n        FILTER (\n            'SATINALMA_TARIHLER',\n            'SATINALMA_TARIHLER'[AyNo] < _TodayMonth\n            || (\n                'SATINALMA_TARIHLER'[AyNo] = _TodayMonth\n                && 'SATINALMA_TARIHLER'[GunNo] <= _TodayDay\n            )\n        )\n    )",
            "lineageTag": "12239a5c-6402-493e-bf81-5cfae73ba725",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_TOPLAM_MIKTAR_YTD_Core",
            "expression": "\nVAR _TodayMonth = MONTH ( TODAY () )\nVAR _TodayDay = DAY ( TODAY () )\nRETURN\n    CALCULATE (\n        [OLC_CIRO_TOPLAM_MIKTAR], // <-- Sadece burası değişti\n        FILTER (\n            'SATINALMA_TARIHLER',\n            'SATINALMA_TARIHLER'[AyNo] < _TodayMonth\n            || (\n                'SATINALMA_TARIHLER'[AyNo] = _TodayMonth\n                && 'SATINALMA_TARIHLER'[GunNo] <= _TodayDay\n            )\n        )\n    )",
            "lineageTag": "f595d6b7-e040-464f-a40e-677f81d68d67",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "CIRO",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Kaynak = Veri(\"CIRO.csv\"),\n    Tipler = Table.TransformColumnTypes(Kaynak, {{\"STOK_KODU\", type text}, {\"STHAR_CARIKOD\", type text}, {\"FISNO\", type text}, {\"STHAR_TARIH\", type datetime}, {\"STHAR_GCMIK\", type number}, {\"STHAR_GCMIK2\", type number}, {\"STHAR_NF\", type number}, {\"STHAR_GCKOD\", type text}, {\"DOLAR_KURU\", type number}, {\"TUTAR_USD\", type number}, {\"YIL\", Int64.Type}, {\"AY\", Int64.Type}, {\"STHAR_SIPNUM\", type text}, {\"STRA_SIPKONT\", Int64.Type}, {\"SIP_INC\", Int64.Type}, {\"AY_BASLANGICI\", type datetime}, {\"SIPARIS_TEMSILCISI\", type text}, {\"TEMSILCI_GRUP\", type text}}, \"en-US\")\nin\n    Tipler"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Gezinme"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
