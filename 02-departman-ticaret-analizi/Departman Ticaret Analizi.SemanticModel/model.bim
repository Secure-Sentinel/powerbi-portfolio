                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Tedarikçi Borç TL",
            "expression": "\nCALCULATE(\n    [OLC_ALACAKBORC_TOPLAMBAKIYE_TL],\n    CARI_ALACAKBORC[DURUM] = \"BORC\",\n    CARI[CARI_TIPI] = \"TEDARIKCI\"\n)",
            "formatString": "\"₺\"#,0.00;-\"₺\"#,0.00;\"₺\"#,0.00",
            "lineageTag": "cf72adc6-3d13-40ce-a521-5b2ea99e7870",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"tr-TR\"}"
              }
            ]
          },
          {
            "name": "Tedarikçi Borç USD",
            "expression": "\nCALCULATE(\n    [OLC_ALACAKBORC_TOPLAMBAKIYE_USD],\n    CARI_ALACAKBORC[DURUM] = \"BORC\",\n    CARI[CARI_TIPI] = \"TEDARIKCI\"\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "a34605d3-f0b5-4000-b6e5-0647c4fcc062"
          },
          {
            "name": "Tedarikçi Alacakları USD",
            "expression": "\nCALCULATE(\n    [OLC_ALACAKBORC_TOPLAMBAKIYE_USD],\n    CARI_ALACAKBORC[DURUM] = \"ALACAK\",\n    CARI[CARI_TIPI] = \"TEDARIKCI\"\n)",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "fede902f-9e78-4d62-9eb2-e05e6b82dacb"
          },
          {
            "name": "Tedarikçi Alacakları TL",
            "expression": "\nCALCULATE(\n    [OLC_ALACAKBORC_TOPLAMBAKIYE_TL],\n    CARI_ALACAKBORC[DURUM] = \"ALACAK\",\n    CARI[CARI_TIPI] = \"TEDARIKCI\"\n)",
            "formatString": "\"₺\"#,0.00;-\"₺\"#,0.00;\"₺\"#,0.00",
            "lineageTag": "0fcf77fc-37f5-4dd8-bf79-c7bcb72a7fd3",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"tr-TR\"}"
              }
            ]
          },
          {
            "name": "ALACAK BAKİYE",
            "expression": "\nSUM ( 'CARI_ALACAKBORC'[ALACAK_TL_MUTLAK] )\n    - SUM ( 'CARI_ALACAKBORC'[BORC_TL] )\n",
            "formatString": "\"₺\"#,0;-\"₺\"#,0;\"₺\"#,0",
