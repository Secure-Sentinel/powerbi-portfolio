          {
            "name": "EN_SON_SIPARIS",
            "type": "calculated",
            "expression": "\nCALCULATE (\n    MAX ( SIPARIS[STHAR_TARIH] ),\n    RELATEDTABLE ( SIPARIS )\n)",
            "dataType": "automatic",
            "formatString": "General Date",
            "summarizeBy": "none",
            "lineageTag": "fbf33aa2-f7ef-4563-91d4-d5ebabc2653f",
            "variations": [
              {
                "name": "Varyasyon",
                "relationship": "4a5d0be3-27ca-46e4-bc83-318529467c08",
                "defaultHierarchy": {
                  "table": "LocalDateTable_4995dd3d-a0c6-4b77-a1d0-f06313f0939d",
                  "hierarchy": "Tarih Hiyerarşisi"
                },
                "isDefault": true
              }
            ],
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "En Son Sipariş Yılı",
            "type": "calculated",
            "expression": "\nYEAR ( CARI[EN_SON_SIPARIS] )",
            "dataType": "automatic",
            "formatString": "0",
            "summarizeBy": "sum",
            "lineageTag": "79382f82-4612-42f8-8edf-832b16971b42",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Cari_Ad_Kisa",
            "type": "calculated",
            "expression": "\nIF(\n    LEN('CARI'[CARI_AD]) > 20, \n    LEFT('CARI'[CARI_AD], 15) & \"...\", \n    'CARI'[CARI_AD]\n)",
            "dataType": "automatic",
            "summarizeBy": "none",
            "lineageTag": "3442e96f-7ccf-40a8-9f0c-e9e2cb4727b9",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "lineageTag": "72878f93-c2c6-4b0a-9732-681109e1624a",
        "measures": [
          {
            "name": "Kart Cari Isim",
            "expression": "\n// 1. Önce seçili siparişin içindeki Cari Kodunu yakala\nVAR _SecilenSiparisinCariKodu = SELECTEDVALUE ( SIPARIS[STHAR_CARIKOD] )\n\n// 2. Bu kodu git CARI tablosunda arat ve İSMİ getir\nRETURN\n    LOOKUPVALUE (\n        CARI[CARI_AD],       // Getirmek istediğin sütun (İsim)\n        CARI[CARI_KOD],        // Nerede arayacak? (Ana tablodaki kod sütunu)\n        _SecilenSiparisinCariKodu // Neyi arayacak? (Siparişteki kod)\n    )",
            "lineageTag": "13dc2b10-26ef-40ee-9a5e-6453b6c1c3e6"
          }
        ],
        "partitions": [
          {
            "name": "CARI",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Kaynak = Veri(\"CARI.csv\"),\n    Tipler = Table.TransformColumnTypes(Kaynak, {{\"CARI_KOD\", type text}, {\"CARI_AD\", type text}, {\"ULKE_KODU\", type text}, {\"ULKEADI\", type text}, {\"GRUP_KODU\", type text}, {\"SEKTOR\", type text}, {\"RAPOR_KODU1\", type text}, {\"BOLGE\", type text}, {\"RAPOR_KODU2\", type text}, {\"SEKTOR2\", type text}, {\"RAPOR_KODU3\", type text}, {\"CARI_TEMSILCI\", type text}, {\"DEPARTMAN\", type text}, {\"CARI_TIPI\", type text}, {\"MUSTERI_YERI\", type text}}, \"en-US\")\nin\n    Tipler"
            }
          }
        ],
        "annotations": [
