        "lineageTag": "e2a23f88-0e79-4f94-9c51-d777d7244fed",
        "measures": [
          {
            "name": "OLC_SIPARIS_TOPLAMTUTAR",
            "expression": "SUM(SIPARIS[TUTAR_USD])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "20b40130-6a3b-4b14-bf1b-10d7589f4bc5",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "OLC_SIPARIS_TOPLAMMIKTAR",
            "expression": "SUM(SIPARIS[STHAR_GCMIK])",
            "formatString": "0",
            "lineageTag": "9f24fcc2-68c6-4526-98aa-1d5ac1ca4fbb",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "OLC_SIPARIS_GONDERILEN",
            "expression": "SUM(SIPARIS[GONDERILEN])",
            "lineageTag": "34dc1143-eaea-4587-803d-29fba9b5238e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_SIPARIS_TOPLAM_KALAN",
            "expression": "SUM(SIPARIS[KALAN])",
            "formatString": "0.0",
            "lineageTag": "c68f39cf-4202-4cae-ab9b-3dfe742a2ae2"
          },
          {
            "name": "OLC_SIPARIS_SIPARISSAYISI",
            "expression": "DISTINCTCOUNT(SIPARIS[FISNO])",
            "formatString": "0",
            "lineageTag": "6da50b11-99f6-4fa1-a8a8-dd2fd85efeaf"
          },
          {
            "name": "OLC_SIPARIS_ORTALAMA_TUTAR",
            "expression": "\nAVERAGEX (\n    SUMMARIZE (\n        SIPARIS,\n        SIPARIS[FISNO],\n        \"TOPLAM\", [OLC_SIPARIS_TOPLAMTUTAR] \n    ),\n    [TOPLAM]\n)",
            "formatString": "\\$#,0.0;(\\$#,0.0);\\$#,0.0",
            "lineageTag": "0cc006d2-5941-470c-af98-f55381bd9dad"
          },
          {
            "name": "OLC_SIPARIS_URUN_SAYISI",
            "expression": "DISTINCTCOUNT(SIPARIS[STOK_KODU])",
            "formatString": "0",
            "lineageTag": "849a531f-9352-4dee-969a-6af2e18dd53e"
          },
          {
            "name": "OLC_SIPARIS_MUSTERISAYISI",
            "expression": "DISTINCTCOUNT(SIPARIS[STHAR_CARIKOD])",
            "formatString": "0",
            "lineageTag": "b41d1e47-a36d-4c43-ba24-b7c34b7668ad"
          },
          {
            "name": "OLC_SIPARIS_ACIKSIPARISTUTAR",
            "expression": "\nCALCULATE (\n    [OLC_SIPARIS_TOPLAMTUTAR], // Temel tutar ölçüsünü kullan\n    SIPARIS[DURUM] = \"ACIK\",\n    REMOVEFILTERS ( 'SATINALMA_TARIHLER' ) // Yıl dilimleyicisini yok say\n)",
            "formatString": "\\$#,0.0;(\\$#,0.0);\\$#,0.0",
            "lineageTag": "d2c01566-6487-4e0b-9cfb-e88d4c78e9fc"
          },
          {
            "name": "OLC_SIPARIS_YENI_MUSTERI_TUTAR",
            "expression": "\nCALCULATE (\n    [OLC_SIPARIS_TOPLAMTUTAR], // SUM(SIPARIS[TUTAR_USD])\n    SIPARIS[Musteri Tipi] = \"Yeni\"\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "9e4a2c94-13cc-4f45-aa2f-d6f80e20fd68",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "OLC_SIPARIS_YENI_MUSTERI_KATKISI",
            "expression": "\nDIVIDE (\n    [OLC_SIPARIS_YENI_MUSTERI_TUTAR],\n    [OLC_SIPARIS_TOPLAMTUTAR],\n    0\n)",
            "formatString": "%0;-%0;%0",
            "lineageTag": "f9555f0c-41ad-4ef7-808e-074735712977"
          },
          {
            "name": "OLC_SIPARIS_ILKTARIH",
            "expression": "MIN(SIPARIS[STHAR_TARIH])",
            "formatString": "Short Date",
            "lineageTag": "a8c123a8-588d-4ba4-bc8d-89384520ece1"
          },
          {
            "name": "OLC_SIPARIS_SONTARIH",
            "expression": "MAX(SIPARIS[STHAR_TARIH])",
            "formatString": "Short Date",
            "lineageTag": "41a68381-7f61-4bfa-a965-c524a02c8fc0"
          },
          {
            "name": "Son Siparisten Gecen Sure (Gün)",
            "expression": "\nVAR SonTarih = [OLC_SIPARIS_SONTARIH]\nVAR Bugun = TODAY()\nVAR GunFarki =\n    IF(\n        ISBLANK(SonTarih) || SonTarih > Bugun,\n        0,\n        DATEDIFF(SonTarih, Bugun, DAY)\n    )\nRETURN\n    GunFarki & \" gün\"\n",
            "lineageTag": "529d41a6-f121-4cad-9e2c-221ea6043b31"
          },
          {
            "name": "OLC_SIPARIS_ACIK_SIPARIS_SAYISI",
            "expression": "\nCALCULATE(\n    [OLC_SIPARIS_SIPARISSAYISI],\n    SIPARIS[DURUM] = \"ACIK\"\n)",
            "formatString": "0",
            "lineageTag": "fe5c76f2-5776-4d14-92a2-451f16afeb5b"
          },
          {
            "name": "OLC_CARI_EN_BUYUK_MIKTAR",
            "expression": "\nMAXX (\n    SUMMARIZE (\n        SIPARIS,\n        SIPARIS[FISNO],\n        \"TOPLAM\", [OLC_SIPARIS_TOPLAMMIKTAR]\n    ),\n    [TOPLAM]\n)",
            "lineageTag": "e267f9d6-5aa0-4996-93ca-8d275e86f396",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_CARI_ENBUYUKSATIS",
            "expression": "\nMAXX (\n    SUMMARIZE (\n        SIPARIS,\n        SIPARIS[FISNO],\n        \"TOPLAM\", [OLC_SIPARIS_TOPLAMTUTAR]\n    ),\n    [TOPLAM]\n)",
            "lineageTag": "00c2a6f7-ce9d-48a1-9312-9cb1cbb7a250",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_MUSTERI_ALACAK",
            "expression": "\nCALCULATE (\n    SUM ( CARI_ALACAKBORC[MUTLAK_USD] ),\n    CARI_ALACAKBORC[DURUM] = \"ALACAK\",\n    CARI_ALACAKBORC[CARI_TIPI] = \"MUSTERI\"\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "6cb1b8aa-95a4-4a97-a342-d6026feeec36"
          },
          {
            "name": "OLC_MUSTERI_BORCU",
            "expression": "\nCALCULATE (\n    SUM ( CARI_ALACAKBORC[MUTLAK_USD] ),\n    CARI_ALACAKBORC[DURUM] = \"BORC\",\n    CARI_ALACAKBORC[CARI_TIPI] = \"MUSTERI\"\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "9c010194-c11b-4359-8794-65dce4b2d394"
          },
          {
            "name": "OLC_SIPARIS_ORTALAMA_MIKTAR",
            "expression": "\nAVERAGEX (\n    SUMMARIZE (\n        SIPARIS,\n        SIPARIS[FISNO],\n        \"TOPLAM\", [OLC_SIPARIS_TOPLAMMIKTAR] // Zaten var olan temel miktar ölçümüz\n    ),\n    [TOPLAM]\n)",
            "lineageTag": "e445c0dd-fe16-4790-a5f4-240416153c37",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_SEKTOR_ORT_MIKTAR",
            "expression": "\nVAR CurrentSektor = SELECTEDVALUE(CARI[SEKTOR])\nRETURN\nCALCULATE(\n    [OLC_SIPARIS_ORTALAMA_MIKTAR], \n    REMOVEFILTERS(CARI),\n    CARI[SEKTOR] = CurrentSektor\n)",
            "lineageTag": "4a1013b7-e35a-4578-a8c7-ca8623300285",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_SEKTOR_ORT_TUTAR",
            "expression": "\nVAR CurrentSektor = SELECTEDVALUE(CARI[SEKTOR])\nRETURN\nCALCULATE(\n    [OLC_SIPARIS_ORTALAMA_TUTAR],\n    REMOVEFILTERS(CARI),\n    CARI[SEKTOR] = CurrentSektor\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "fa1b533b-af40-4d5e-b10f-f12eb8aa52c3"
          },
          {
            "name": "OLC_ULKE_ORT_MIKTAR",
            "expression": "\nVAR CurrentUlke = SELECTEDVALUE(CARI[ULKEADI])\nRETURN\nCALCULATE(\n    [OLC_SIPARIS_ORTALAMA_MIKTAR],\n    REMOVEFILTERS(CARI),\n    CARI[ULKEADI] = CurrentUlke\n)",
            "lineageTag": "2f2a62be-2d86-4351-9e68-166763a45f32",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "OLC_ULKE_ORT_TUTAR",
            "expression": "\nVAR CurrentUlke = SELECTEDVALUE(CARI[ULKEADI])\nRETURN\nCALCULATE(\n    [OLC_SIPARIS_ORTALAMA_TUTAR], // Yukarıda onayladığımız ölçü\n    REMOVEFILTERS(CARI),\n    CARI[ULKEADI] = CurrentUlke\n)",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "37a8c4f5-931f-4aa0-b339-eb1186ff13ae"
          },
          {
            "name": "Peşinat Tutar Oranı",
            "expression": "\nDIVIDE (\n    [OLC_SIPARIS_TOPLAMTUTAR],\n    CALCULATE (\n        [OLC_SIPARIS_TOPLAMTUTAR],\n        ALLSELECTED ( SIPARIS[ODEME_ACIKLAMA] )\n    ),\n    0\n)",
            "formatString": "%0.0;-%0.0;%0.0",
            "lineageTag": "7f93beab-1ecb-41c4-bef0-3276110e7f26"
          },
          {
            "name": "Yeni Müşteri Sayısı",
            "expression": "\nVAR SeciliBaslangic = MIN('SATINALMA_TARIHLER'[Tarih])\n\nRETURN\nCALCULATE(\n    DISTINCTCOUNT('SIPARIS'[STHAR_CARIKOD]),\n    FILTER(\n        VALUES('SIPARIS'[STHAR_CARIKOD]),\n        VAR Musterinin_Miladi = \n            CALCULATE(\n                MIN('SIPARIS'[STHAR_TARIH]), \n                ALL('SATINALMA_TARIHLER') \n            )\n        RETURN\n        -- Eğer miladı, seçili döneme eşit veya büyükse\n        Musterinin_Miladi >= SeciliBaslangic\n    )\n)",
            "formatString": "0",
            "lineageTag": "3e5dcbea-96a6-485f-9169-10fd0faf3dcf"
          },
          {
            "name": "Mevcut Müşteri Sayısı",
            "expression": "\nVAR SeciliBaslangic = MIN('SATINALMA_TARIHLER'[Tarih]) -- Ekranda seçili dönemin başı\n\nRETURN\nCALCULATE(\n    DISTINCTCOUNT('SIPARIS'[STHAR_CARIKOD]),\n    FILTER(\n        VALUES('SIPARIS'[STHAR_CARIKOD]), -- O an ekranda olan müşterileri tek tek gez\n        VAR Musterinin_Miladi = \n            CALCULATE(\n                MIN('SIPARIS'[STHAR_TARIH]), \n                ALL('SATINALMA_TARIHLER') -- İŞTE SİHİR BURADA: Tarih filtresini tamamen kaldır!\n            )\n        RETURN\n        -- Eğer miladı, seçili dönemden küçükse (eskiyse)\n        Musterinin_Miladi < SeciliBaslangic && NOT(ISBLANK(Musterinin_Miladi))\n    )\n)",
            "formatString": "0",
            "lineageTag": "786857ad-f6b3-4e8f-8586-ea3406883208"
          },
          {
            "name": "Filtre_Gecmis_Ciro_Kontrol",
            "expression": "\nCALCULATE(\n    [OLC_SIPARIS_TOPLAMTUTAR], \n    REMOVEFILTERS(SATINALMA_TARIHLER)\n)",
            "lineageTag": "6884d922-8028-4093-9d72-ddd05a791989",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "SIPARIS",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Kaynak = Veri(\"SIPARIS.csv\"),\n    Tipler = Table.TransformColumnTypes(Kaynak, {{\"INCKEYNO\", Int64.Type}, {\"STHAR_TARIH\", type date}, {\"FISNO\", type text}, {\"SIRA\", Int64.Type}, {\"STOK_KODU\", type text}, {\"STHAR_CARIKOD\", type text}, {\"STHAR_GCMIK\", type number}, {\"STHAR_NF\", type number}, {\"GONDERILEN\", type number}, {\"KALAN\", type number}, {\"SIPARIS_TEMSILCI\", type text}, {\"DEPARTMAN\", type text}, {\"STHAR_GCKOD\", type text}, {\"DOLAR_KURU\", type number}, {\"STHAR_KOD1\", type text}, {\"STHAR_KOD2\", type text}, {\"TUTAR_USD\", type number}, {\"DURUM\", type text}, {\"YIL\", Int64.Type}, {\"AY\", Int64.Type}, {\"HAFTA\", Int64.Type}, {\"ODEKOD\", type text}, {\"ODEME_ACIKLAMA\", type text}, {\"PESINAT_ORANI\", type number}, {\"VADE_GUNU\", Int64.Type}, {\"PESIN_TUTAR\", type number}, {\"VADELI_TUTAR\", type number}, {\"RPT\", Int64.Type}, {\"KACINCI_SIPARIS\", Int64.Type}, {\"MUSTERI_SIP_NO\", type text}, {\"TESLIM_YERI\", type text}, {\"EK_ACIKLAMA_1\", type text}, {\"EK_ACIKLAMA_2\", type text}, {\"EK_ACIKLAMA_3_MALZEME\", type text}, {\"EK_ACIKLAMA_4\", type text}, {\"EK_ACIKLAMA_5\", type text}}, \"en-US\")\nin\n    Tipler"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Gezinme"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
