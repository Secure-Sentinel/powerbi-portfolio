    "expressions": [
      {
        "name": "VeriKaynagi",
        "kind": "m",
        "expression": "\"https://raw.githubusercontent.com/Secure-Sentinel/powerbi-portfolio/main/01-scada-uretim-izleme/data/\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "description": "CSV veri klasörü: GitHub raw adresi veya yerel klasör yolu.",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Gezinti"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "Veri",
        "kind": "m",
        "expression": "let\n    // Tek giriş noktası: VeriKaynagi parametresi ya bir HTTPS adresi\n    // (GitHub raw) ya da yerel bir klasör yolu olabilir.\n    Veri = (dosya as text) as table =>\n        let\n            Icerik =\n                if Text.StartsWith(VeriKaynagi, \"http\") then\n                    Web.Contents(VeriKaynagi, [RelativePath = dosya])\n                else\n                    File.Contents(\n                        VeriKaynagi\n                        & (if Text.EndsWith(VeriKaynagi, \"\\\") then \"\" else \"\\\")\n                        & dosya\n                    ),\n            Ayrilmis = Csv.Document(\n                Icerik,\n                [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]\n            ),\n            Basliklar = Table.PromoteHeaders(Ayrilmis, [PromoteAllScalars = true])\n        in\n            Basliklar\nin\n    Veri",
        "description": "Verilen CSV dosyasını okuyup başlıkları yükseltir.",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "1"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"VeriKaynagi\", \"Veri\", \"VW_ARIZA\", \"VW_DEVAM_EDEN_ISLER\", \"VW_ISEMRI\", \"VW_STOK\", \"VW_AKTIVITE\", \"VW_URETIM_HAFTALIK\", \"VW_PUANTAJ_GUNLUK\", \"VW_PUANTAJ_HAFTALIK\", \"URETIM_VERI_OEE\", \"TBLMRPMAKINE\", \"SON_GUNCELLEME\", \"CALISAN_SAYISI\"]"
      }
    ]
  }
