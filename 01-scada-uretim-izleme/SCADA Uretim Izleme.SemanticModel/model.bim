          {
            "name": "Durum_Onceligi",
            "type": "calculated",
            "expression": "\nSWITCH( 'URETIM_VERI_OEE'[ISLEM_DURUMU],\n    \"ARIZA/DURUŞ\", 1,    -- En kritik, en üstte\n    \"ISLEM\", 2,          -- Aktif çalışıyor, ikinci sırada\n    \"HAZIRLIK\", 3,       -- Üçüncü sırada\n    \"PASIF\", 4,          -- Sırada bekleyen\n    \"TAMAMLANDI\", 5,     -- Üretim bitmiş, kapanış bekliyor\n    \"KAPATILDI\", 6,      -- Finalize edilmiş, en alta at\n    7\n)",
            "dataType": "automatic",
            "formatString": "0",
            "summarizeBy": "sum",
            "lineageTag": "2234106f-9e7b-4492-a622-7e64621ab670",
