        ],
        "lineageTag": "72433614-0285-4f33-a627-484822573154",
        "measures": [
          {
            "name": "1",
            "expression": "\".\"",
            "lineageTag": "029aab55-e67b-4230-bed7-b8817c3f523b"
          },
          {
            "name": "Renk_Olcusu",
            "expression": "\nVAR KayitSayisi = COUNTROWS('URETIM_VERI_OEE') -- O anki filtrede gerçekten satır var mı?\nVAR Durumlar = VALUES('URETIM_VERI_OEE'[ISLEM_DURUMU]) \nRETURN\nIF(\n    ISBLANK(KayitSayisi), \n    BLANK(),  -- İşte sır burada! Veri yoksa BOŞ dön, böylece Power BI sahte satır üretmez.\n    SWITCH( TRUE(),\n        \"ARIZA/DURUŞ\" IN Durumlar, \"#FF0000\",\n        \"ISLEM\" IN Durumlar, \"#00FF00\",\n        \"HAZIRLIK\" IN Durumlar, \"#FFFF00\",\n        \"PASIF\" IN Durumlar, \"#00BFFF\"\n    )\n)",
            "lineageTag": "e6211194-7f6b-4488-9a39-3cf8b8ee07a0"
          },
          {
            "name": "Led_Rengi",
            "expression": "\nVAR Durumlar = VALUES('URETIM_VERI_OEE'[ISLEM_DURUMU]) \nRETURN\nSWITCH( TRUE(),\n    \"ARIZA/DURUŞ\" IN Durumlar, \"#FF0000\",\n    \"ISLEM\" IN Durumlar, \"#00FF00\",\n    \"HAZIRLIK\" IN Durumlar, \"#FFFF00\",\n    \"PASIF\" IN Durumlar, \"#00BFFF\",\n    \"#1A1A1A\"  -- Hiçbir veri yoksa veya eşleşmiyorsa Koyu Gri/Siyah\n)",
            "lineageTag": "9a7af82d-f841-4aa7-beba-a25089b116ca"
          },
          {
            "name": "Aktif_Makine",
            "expression": "\nCALCULATE(\n    DISTINCTCOUNT('URETIM_VERI_OEE'[DEMIR_KODU]),\n    'URETIM_VERI_OEE'[ISLEM_DURUMU] = \"ISLEM\"\n)",
            "formatString": "0",
            "lineageTag": "c3846913-263b-410b-9338-2e23cd58077a"
          },
          {
            "name": "Arizali_Makine",
            "expression": "\nCALCULATE(\n    DISTINCTCOUNT('URETIM_VERI_OEE'[DEMIR_KODU]),\n    'URETIM_VERI_OEE'[ISLEM_DURUMU] = \"ARIZA/DURUŞ\"\n)",
            "formatString": "0",
            "lineageTag": "803bc907-2703-4fda-9845-18727e59a7be"
          },
          {
            "name": "Pasif_Makine",
            "expression": "\nCALCULATE(\n    DISTINCTCOUNT('URETIM_VERI_OEE'[DEMIR_KODU]),\n    'URETIM_VERI_OEE'[ISLEM_DURUMU] = \"PASIF\"\n)",
            "formatString": "0",
            "lineageTag": "41fe8e2f-39fb-4070-b7ee-6ab7e2d5aeaa"
          },
          {
            "name": "Tablo_Rengi",
            "expression": "\nVAR KayitSayisi = COUNTROWS('URETIM_VERI_OEE')\nVAR Durumlar = VALUES('URETIM_VERI_OEE'[ISLEM_DURUMU]) \nRETURN\nIF(\n    ISBLANK(KayitSayisi), \n    BLANK(),  -- Tablonun çoğalmasını engeller!\n    SWITCH( TRUE(),\n        \"ARIZA/DURUŞ\" IN Durumlar, \"#FF0000\",   -- Kırmızı (Kritik)\n        \"ISLEM\" IN Durumlar, \"#00FF00\",         -- Fosforlu Yeşil (Aktif Üretim)\n        \"HAZIRLIK\" IN Durumlar, \"#FFFF00\",      -- Sarı (Set-up / Duruş)\n        \"PASIF\" IN Durumlar, \"#00BFFF\",         -- Mavi (Sırada Bekleyen/Yarım)\n        \"TAMAMLANDI\" IN Durumlar, \"#00CED1\",    -- Turkuaz (Üretim Bitti, Kapanış Bekliyor)\n        \"KAPATILDI\" IN Durumlar, \"#808080\"      -- Gri (Finalize Edildi, Arşive Kalktı)\n    )\n)",
            "lineageTag": "fb6a1861-b292-4758-9d5b-db2640d789f5"
          },
          {
            "name": "Durum_Sinyali",
            "expression": "\nVAR KayitVarMi = COUNTROWS('URETIM_VERI_OEE')\nRETURN\nIF(\n    ISBLANK(KayitVarMi), \n    BLANK(),  -- O makineye ait olmayan işlerde yuvarlağı gizle (Tabloyu temiz tutar!)\n    \"⬤\"       -- Kayıt varsa yuvarlağı koy\n)",
            "lineageTag": "6bd0679b-db33-48cb-86a8-3aa84c74a344"
          },
          {
            "name": "Tamamlanma_Yuzdesi",
            "expression": "\nVAR HesaplananYuzde = \n    DIVIDE(\n        AVERAGE('URETIM_VERI_OEE'[URETILENMIKTAR]), \n        AVERAGE('URETIM_VERI_OEE'[ISEMRI_MIKTARI]), \n        BLANK()\n    )\nRETURN \n    IF(\n        ISBLANK(HesaplananYuzde), \n        BLANK(), \n        MIN(HesaplananYuzde, 1)\n    )",
            "formatString": "%0;-%0;%0",
            "lineageTag": "59ffb496-ceda-4299-a3cc-60852c9e70f4"
          },
          {
            "name": "İşçi SVG Gelişmiş",
            "expression": "\nVAR v1 = COALESCE(MAX('URETIM_VERI_OEE'[BANT_LIDERI]), 0)\nVAR v2 = COALESCE(MAX('URETIM_VERI_OEE'[SEKILLENDIRME]), 0)\nVAR v3 = COALESCE(MAX('URETIM_VERI_OEE'[KALITECI]), 0)\nVAR v4 = COALESCE(MAX('URETIM_VERI_OEE'[PAKETLEMECI]), 0)\nVAR v5 = COALESCE(MAX('URETIM_VERI_OEE'[PRES_OPR]), 0)\nVAR v6 = COALESCE(MAX('URETIM_VERI_OEE'[PRES_ISTIFLEYICI]), 0)\nVAR v7 = COALESCE(MAX('URETIM_VERI_OEE'[MAKAS_OPR]), 0)\nVAR v8 = COALESCE(MAX('URETIM_VERI_OEE'[BASKI_OPR]), 0)\n\nVAR totalWorkers = v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8\n\n-- TASARIM AYARLARI \nVAR barW = 34  -- Genişlik\nVAR barH = 28  -- Yükseklik\nVAR gap = 6    -- Boşluk\n\nVAR x1 = 0\nVAR w1 = IF(v1 > 0, barW, 0)\nVAR g1 = IF(v1 > 0, gap, 0)\nVAR x2 = x1 + w1 + g1\nVAR w2 = IF(v2 > 0, barW, 0)\nVAR g2 = IF(v2 > 0, gap, 0)\nVAR x3 = x2 + w2 + g2\nVAR w3 = IF(v3 > 0, barW, 0)\nVAR g3 = IF(v3 > 0, gap, 0)\nVAR x4 = x3 + w3 + g3\nVAR w4 = IF(v4 > 0, barW, 0)\nVAR g4 = IF(v4 > 0, gap, 0)\nVAR x5 = x4 + w4 + g4\nVAR w5 = IF(v5 > 0, barW, 0)\nVAR g5 = IF(v5 > 0, gap, 0)\nVAR x6 = x5 + w5 + g5\nVAR w6 = IF(v6 > 0, barW, 0)\nVAR g6 = IF(v6 > 0, gap, 0)\nVAR x7 = x6 + w6 + g6\nVAR w7 = IF(v7 > 0, barW, 0)\nVAR g7 = IF(v7 > 0, gap, 0)\nVAR x8 = x7 + w7 + g7\nVAR w8 = IF(v8 > 0, barW, 0)\n\n-- RENK KODLARI (Güncellendi)\nVAR c1 = \"%232D9CDB\" -- Mavi (Bant Lideri)\nVAR c2 = \"%2327AE60\" -- Yeşil (Şekillendirme)\nVAR c3 = \"%238D6E63\" -- Kahverengi (Kaliteci)\nVAR c4 = \"%239B51E0\" -- Mor (Paketlemeci)\nVAR c5 = \"%23EB5757\" -- Kırmızı (Pres Opr)\nVAR c6 = \"%23212121\" -- Siyah (Pres İstif)\nVAR c7 = \"%23F8F9F9\" -- Beyaz/Açık Gri (Makas Opr) - Yazısı siyah olacak\nVAR c8 = \"%23F2994A\" -- Turuncu (Baskı Opr)\n\n-- TEXT y='19' İLE DİKEYDE ORTALAMA DÜZELTİLDİ\nVAR svg1 = IF(v1 > 0, \"<g><rect x='\" & x1 & \"' y='0' rx='4' ry='4' width='\" & barW & \"' height='\" & barH & \"' fill='\" & c1 & \"'/><text x='\" & (x1 + barW/2) & \"' y='19' fill='white' font-family='Segoe UI, Arial' font-weight='bold' font-size='14' text-anchor='middle'>\" & v1 & \"</text></g>\", \"\")\nVAR svg2 = IF(v2 > 0, \"<g><rect x='\" & x2 & \"' y='0' rx='4' ry='4' width='\" & barW & \"' height='\" & barH & \"' fill='\" & c2 & \"'/><text x='\" & (x2 + barW/2) & \"' y='19' fill='white' font-family='Segoe UI, Arial' font-weight='bold' font-size='14' text-anchor='middle'>\" & v2 & \"</text></g>\", \"\")\nVAR svg3 = IF(v3 > 0, \"<g><rect x='\" & x3 & \"' y='0' rx='4' ry='4' width='\" & barW & \"' height='\" & barH & \"' fill='\" & c3 & \"'/><text x='\" & (x3 + barW/2) & \"' y='19' fill='white' font-family='Segoe UI, Arial' font-weight='bold' font-size='14' text-anchor='middle'>\" & v3 & \"</text></g>\", \"\")\nVAR svg4 = IF(v4 > 0, \"<g><rect x='\" & x4 & \"' y='0' rx='4' ry='4' width='\" & barW & \"' height='\" & barH & \"' fill='\" & c4 & \"'/><text x='\" & (x4 + barW/2) & \"' y='19' fill='white' font-family='Segoe UI, Arial' font-weight='bold' font-size='14' text-anchor='middle'>\" & v4 & \"</text></g>\", \"\")\nVAR svg5 = IF(v5 > 0, \"<g><rect x='\" & x5 & \"' y='0' rx='4' ry='4' width='\" & barW & \"' height='\" & barH & \"' fill='\" & c5 & \"'/><text x='\" & (x5 + barW/2) & \"' y='19' fill='white' font-family='Segoe UI, Arial' font-weight='bold' font-size='14' text-anchor='middle'>\" & v5 & \"</text></g>\", \"\")\nVAR svg6 = IF(v6 > 0, \"<g><rect x='\" & x6 & \"' y='0' rx='4' ry='4' width='\" & barW & \"' height='\" & barH & \"' fill='\" & c6 & \"'/><text x='\" & (x6 + barW/2) & \"' y='19' fill='white' font-family='Segoe UI, Arial' font-weight='bold' font-size='14' text-anchor='middle'>\" & v6 & \"</text></g>\", \"\")\nVAR svg7 = IF(v7 > 0, \"<g><rect x='\" & x7 & \"' y='0' rx='4' ry='4' width='\" & barW & \"' height='\" & barH & \"' fill='\" & c7 & \"'/><text x='\" & (x7 + barW/2) & \"' y='19' fill='%23000000' font-family='Segoe UI, Arial' font-weight='bold' font-size='14' text-anchor='middle'>\" & v7 & \"</text></g>\", \"\")\nVAR svg8 = IF(v8 > 0, \"<g><rect x='\" & x8 & \"' y='0' rx='4' ry='4' width='\" & barW & \"' height='\" & barH & \"' fill='\" & c8 & \"'/><text x='\" & (x8 + barW/2) & \"' y='19' fill='white' font-family='Segoe UI, Arial' font-weight='bold' font-size='14' text-anchor='middle'>\" & v8 & \"</text></g>\", \"\")\n\nVAR SvgCode = \n\"data:image/svg+xml;utf8,\" & \n\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 32' width='320' height='32'>\" &\n    svg1 & svg2 & svg3 & svg4 & svg5 & svg6 & svg7 & svg8 &\n\"</svg>\"\n\nRETURN \n    IF(totalWorkers > 0, SvgCode, BLANK())",
            "lineageTag": "79aa618e-cf9a-481d-aa7d-a8368adfee9e",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "İşçi Renk Lejantı",
            "expression": "\n\"data:image/svg+xml;utf8,\" & \n\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 55' width='512' height='55'>\n    <circle cx='15' cy='15' r='6' fill='%232D9CDB'/><text x='30' y='20' font-family='Segoe UI, Arial' font-weight='600' font-size='14' fill='%23555555'>Bant Lideri</text>\n    \n    <circle cx='135' cy='15' r='6' fill='%2327AE60'/><text x='150' y='20' font-family='Segoe UI, Arial' font-weight='600' font-size='14' fill='%23555555'>Şekillendirme</text>\n    \n    <circle cx='280' cy='15' r='6' fill='%23F2994A'/><text x='295' y='20' font-family='Segoe UI, Arial' font-weight='600' font-size='14' fill='%23555555'>Kaliteci</text>\n    \n    <circle cx='385' cy='15' r='6' fill='%239B51E0'/><text x='400' y='20' font-family='Segoe UI, Arial' font-weight='600' font-size='14' fill='%23555555'>Paketlemeci</text>\n    \n    <circle cx='15' cy='40' r='6' fill='%23EB5757'/><text x='30' y='45' font-family='Segoe UI, Arial' font-weight='600' font-size='14' fill='%23555555'>Pres Opr</text>\n    \n    <circle cx='135' cy='40' r='6' fill='%2334495E'/><text x='150' y='45' font-family='Segoe UI, Arial' font-weight='600' font-size='14' fill='%23555555'>Pres İstif</text>\n    \n    <circle cx='280' cy='40' r='6' fill='%23F2C94C'/><text x='295' y='45' font-family='Segoe UI, Arial' font-weight='600' font-size='14' fill='%23555555'>Makas Opr</text>\n    \n    <circle cx='385' cy='40' r='6' fill='%23E84393'/><text x='400' y='45' font-family='Segoe UI, Arial' font-weight='600' font-size='14' fill='%23555555'>Baskı Opr</text>\n</svg>\"",
            "lineageTag": "4e9ce8aa-e5d6-497e-84e6-fec1ad13eeec",
            "dataCategory": "ImageUrl"
          }
        ],
        "partitions": [
          {
            "name": "URETIM_VERI_OEE",
            "mode": "import",
            "source": {
              "type": "m",
