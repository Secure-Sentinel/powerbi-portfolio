        "lineageTag": "632c2f5d-e7c4-419e-a2e5-befdc18b0718",
        "measures": [
          {
            "name": "ISSAYISI_OLCU",
            "expression": "COUNT([TAKIP_ID])",
            "formatString": "0",
            "lineageTag": "521c2359-4257-4c85-8baf-976efb98c588"
          },
          {
            "name": "ORT_CALISAN",
            "expression": "\nVAR ToplamIslem = SUM('VW_DEVAM_EDEN_ISLER'[ISLEM])\nVAR ToplamInsanSaat = SUM('VW_DEVAM_EDEN_ISLER'[INSANSAAT_ISLEM])\nRETURN\n    IF(\n        ISBLANK(ToplamIslem) || ToplamIslem = 0,\n        BLANK(),\n        DIVIDE(ToplamInsanSaat * 60, ToplamIslem, BLANK())\n    )",
            "lineageTag": "461450ae-e224-4a00-8e3c-eaead4403d75",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "TOPLAM_CALISAN_SAYISI_OLCU",
            "expression": "[ORT_CALISAN]*COUNT([TAKIP_ID])",
            "lineageTag": "a5fa5b38-9f2e-49fb-b847-65f43e2c91b9",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "VERIM_OLCU",
            "expression": "\nVAR ToplamIslem =\n    CALCULATE(\n        SUM('VW_DEVAM_EDEN_ISLER'[ISLEM]),\n        'VW_DEVAM_EDEN_ISLER'[KT_VERIMTAKIP] = \"E\",\n        'VW_DEVAM_EDEN_ISLER'[ISLEM] > 0,\n        NOT ISBLANK('VW_DEVAM_EDEN_ISLER'[STDSURE_V])\n    )\nVAR ToplamStdSure =\n    CALCULATE(\n        SUM('VW_DEVAM_EDEN_ISLER'[STDSURE_V]),\n        'VW_DEVAM_EDEN_ISLER'[KT_VERIMTAKIP] = \"E\",\n        'VW_DEVAM_EDEN_ISLER'[ISLEM] > 0,\n        NOT ISBLANK('VW_DEVAM_EDEN_ISLER'[STDSURE_V])\n    )\nRETURN\n    IF(\n        ISBLANK(ToplamIslem) || ToplamIslem = 0,\n        BLANK(),\n        MIN(DIVIDE(ToplamStdSure, ToplamIslem, BLANK()), 1)\n    )",
            "formatString": "0",
            "lineageTag": "f2859057-4964-41f0-b733-288f2f4d0a2a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "VW_DEVAM_EDEN_ISLER",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Kaynak = Veri(\"VW_DEVAM_EDEN_ISLER.csv\"),\n    Tipler = Table.TransformColumnTypes(Kaynak, {{\"TAKIP_ID\", Int64.Type}, {\"ISEMRINO\", type text}, {\"AKTIVITEKODU\", type text}, {\"AKTIVITE_ADI\", type text}, {\"BASLANGICTARIH\", type datetime}, {\"DEVAM_EDENSURE\", Int64.Type}, {\"MIKTAR\", type number}, {\"DEMIR_KODU\", type text}, {\"ISTISIM\", type text}, {\"KAPATILDI\", type text}, {\"OPKODU\", type text}, {\"STOK_ADI\", type text}, {\"STOK_KODU\", type text}, {\"CARI_ISIM\", type text}, {\"SIPARIS_NO\", type text}, {\"REFISEMRINO\", type text}, {\"URETIM\", type number}, {\"FIRE\", type number}, {\"HAZIRLIK\", type number}, {\"ISLEM\", type number}, {\"ARIZA\", type number}, {\"STDSURE_V\", type number}, {\"TAMAMLANMA\", type number}, {\"INSANSAAT_HAZIRLIK\", type number}, {\"INSANSAAT_ISLEM\", type number}, {\"ORTALAMA_CALISAN_SAYISI\", type number}, {\"VERIM_TAKIPET\", type text}, {\"KT_VERIMTAKIP\", type text}}, \"en-US\")\nin\n    Tipler"
            }
          }
        ],
